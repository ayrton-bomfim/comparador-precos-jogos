# Copie este arquivo para ".env" na RAIZ do projeto (backend/config.py lê dali).
# Nunca versione o .env real.

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comparador_precos

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
# Origens permitidas no CORS, separadas por vírgula. Vazio = endereços locais do Vite.
CORS_ORIGINS=

# --- Autenticação ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=360
# Login com Google (mesmo Client ID usado no frontend).
GOOGLE_CLIENT_ID=

# Administrador inicial (python -m backend.ferramentas.criar_admin).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Frontend público (links de confirmação e recuperação de senha) ---
FRONTEND_URL=http://localhost:5173

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Coleta ---
# Horário da coleta diária do agendador (HH:MM).
COLETA_HORARIO=03:00
STEAM_API_KEY=
# Usada apenas pela ferramenta importar_historico_itad.
ITAD_API_KEY=
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=60000
REQUEST_DELAY=2
