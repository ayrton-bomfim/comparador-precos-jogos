# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comparador_precos

# Coleta
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=60000
REQUEST_DELAY=2

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Frontend público usado em links de recuperação de senha e confirmação de e-mail.
# Em desenvolvimento local, use http://localhost:5173.
# Em produção, use https://desctrl.com.br.
FRONTEND_URL=http://localhost:5173

# E-mail transacional via Resend.
# Nunca coloque a chave real no .env.example nem a envie ao GitHub.
RESEND_API_KEY=
# Para desenvolvimento, o Resend pode aceitar onboarding@resend.dev conforme as limitações da conta.
# Em produção, configure um remetente no domínio verificado, por exemplo:
# RESEND_FROM_EMAIL=DESCTRL <alertas@desctrl.com.br>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Autenticacao: configure uma chave forte e exclusiva no arquivo .env.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
